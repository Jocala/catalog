<Window x:Class="CatalogWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CatalogWin.UI"
        Title="Jocala Catalog" Width="912" Height="794" MinWidth="912" MaxWidth="912" MinHeight="600">
        <!-- Fixed width = 4 tiles x 200 + scrollbar 17 + resize border 2x4 + toolbar
             slack (Fluent control chrome is roomier than classic; gallery tiles
             stay 200 wide and centered, macOS 4-across parity). -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewWindow_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.New" Key="N" Modifiers="Ctrl"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- Shared book/author/series tile (187x240 cover + title + subtitle).
             Tag tiles swap the cover box for a big label (macOS tagGridItem parity). -->
        <DataTemplate x:Key="TileTemplate">
            <Border Width="200" Height="300" Background="Transparent" Cursor="Hand"
                    HorizontalAlignment="Center"
                    Loaded="Tile_Loaded" MouseLeftButtonUp="Tile_Click" Tag="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show Details" Click="CtxDetails_Click"/>
                        <MenuItem Header="Open on Kobo" Click="CtxKobo_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Border x:Name="CoverBorder" Width="187" Height="240" CornerRadius="6" Background="{DynamicResource AppTileBack}"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Image Width="187" Height="240" Stretch="Uniform"
                                   Source="{Binding Thumb}" x:Name="CoverImg"/>
                            <TextBlock Text="No cover" Foreground="{DynamicResource AppMuted}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Name="CoverPlaceholder"/>
                            <!-- Solid tan tag (macOS tag.fill parity) -->
                            <Viewbox Width="110" Height="110" Visibility="Collapsed" x:Name="TagGlyph"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="50" Height="30">
                                    <Path Fill="#C8A96E" Data="M 2,0 L 38,0 L 48,12 L 38,24 L 2,24 L 2,0 Z M 38,12 A 3,3 0 1 1 38.1,12 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" MaxHeight="32" TextTrimming="CharacterEllipsis"
                               Margin="6,6,6,0" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource AppMuted}"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,6,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumb}" Value="{x:Null}">
                    <Setter TargetName="CoverImg" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="tag">
                    <Setter TargetName="CoverBorder" Property="Background" Value="Transparent"/>
                    <Setter TargetName="CoverImg" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CoverPlaceholder" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TagGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Standard Windows menu bar: File + Help (toolbar below keeps
             the Mac-parity buttons). About lives under Help per convention. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Window" Command="ApplicationCommands.New"/>
                <Separator/>
                <MenuItem Header="_Settings…" Click="Settings_Click"/>
                <MenuItem Header="_Open Data Folder" Click="OpenDataFolder_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Jocala Catalog _Help" Click="Help_Click"/>
                <Separator/>
                <MenuItem Header="_About Jocala Catalog" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <!-- Toolbar (macOS ContentView header parity) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppPanelBackground}" Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="🔍" Width="36" Padding="0" FontSize="14"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Click="Search_Click" ToolTip="Search Books"/>
                <Button Content="Reload" Margin="4,0,0,0" Click="Reload_Click"/>
                <Button Content="Settings" Margin="4,0,0,0" Click="Settings_Click"/>
                <Separator Margin="6,0" Visibility="Visible"/>
                <ComboBox x:Name="BrowseBox" Width="120" Margin="0,0,4,0"
                          SelectionChanged="Browse_Changed" ToolTip="Browse: Books, Author, Series, or Tags"/>
                <ComboBox x:Name="SortBox" Width="120" Margin="0,0,4,0"
                          SelectionChanged="Sort_Changed" ToolTip="Sort order"/>
                <Separator Margin="6,0"/>
                <RadioButton Content="Grid" GroupName="View" Margin="0,0,4,0"
                             VerticalAlignment="Center" Checked="ViewGrid_Checked" x:Name="GridRadio" IsChecked="True"/>
                <RadioButton Content="List" GroupName="View" VerticalAlignment="Center" Checked="ViewList_Checked"/>
                <Button x:Name="LibraryBtn" Content="Library" Margin="8,0,0,0" Visibility="Collapsed"
                         FontWeight="Bold" Click="Library_Click" ToolTip="Back to library"/>
            </StackPanel>
        </Border>

        <!-- Bottom status bar: the sole landing spot for gallery status
             (counts / search results / Kobo messages). Toolbar above is controls-only.
             x:Name kept as StatusText so the code-behind binding is untouched. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppPanelBackground}" Padding="12,4">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMuted}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Loading -->
        <StackPanel x:Name="LoadingView" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="200" Height="16"/>
            <TextBlock Text="Loading…" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Empty -->
        <StackPanel x:Name="EmptyView" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="EmptyTitle" Text="No books" FontSize="16" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center"/>
            <TextBlock Text="Set the SMB server and Calibre path in Settings → SMB"
                       FontSize="12" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" Margin="0,8,0,8"/>
            <Button Content="Open Settings" HorizontalAlignment="Center" Click="Settings_Click"/>
        </StackPanel>

        <!-- Books grid (windowed: UniformGrid renders ~14 rows between
             spacers that preserve the full scroll extent) -->
        <ScrollViewer x:Name="GridScroll" Visibility="Collapsed"
                      ScrollChanged="Grid_ScrollChanged" SizeChanged="Grid_SizeChanged">
            <StackPanel>
                <Border x:Name="GridTopPad" Height="0"/>
                <ItemsControl x:Name="GridItems" ItemTemplate="{StaticResource TileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Fixed 4 across (macOS LazyVGrid count:4 parity);
                                 tiles stay 200 wide, centered in their cell. -->
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border x:Name="GridBottomPad" Height="0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Books list -->
        <ListView x:Name="ListItems" Visibility="Collapsed" MouseDoubleClick="List_Open">
            <ListView.Resources>
                <DataTemplate x:Key="ListThumbTemplate">
                    <Grid Width="40" Height="60">
                        <Image Width="40" Height="60" Stretch="Uniform" Source="{Binding Thumb}" x:Name="ListCoverImg"/>
                        <TextBlock Text="No cover" Foreground="{DynamicResource AppMuted}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ListNoCover"/>
                        <Viewbox Width="32" Height="20" Visibility="Collapsed" x:Name="ListTagGlyph" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="50" Height="30">
                                <Path Fill="#C8A96E" Data="M 2,0 L 38,0 L 48,12 L 38,24 L 2,24 L 2,0 Z M 38,12 A 3,3 0 1 1 38.1,12 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Thumb}" Value="{x:Null}">
                            <Setter TargetName="ListCoverImg" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="tag">
                            <Setter TargetName="ListCoverImg" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ListNoCover" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ListTagGlyph" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="70" CellTemplate="{StaticResource ListThumbTemplate}"/>
                    <GridViewColumn Header="Title" Width="320" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Author" Width="200" DisplayMemberBinding="{Binding Subtitle}"/>
                    <GridViewColumn Header="Path" Width="380" DisplayMemberBinding="{Binding Path}"/>
                </GridView>
            </ListView.View>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Details" Click="CtxDetails_Click"/>
                    <MenuItem Header="Open on Kobo" Click="CtxKobo_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <!-- Drill-in -->
        <DockPanel x:Name="DrillView" Visibility="Collapsed" LastChildFill="True">
            <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource AppPanelBackground}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="‹ Back" Click="DrillBack_Click"/>
                    <TextBlock x:Name="DrillTitle" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                    <ProgressBar x:Name="DrillSpin" IsIndeterminate="True" Width="80" Height="12"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="DrillCount" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="DrillScroll" ScrollChanged="Drill_ScrollChanged" SizeChanged="Drill_SizeChanged">
                <StackPanel>
                    <Border x:Name="DrillTopPad" Height="0"/>
                    <ItemsControl x:Name="DrillItems" ItemTemplate="{StaticResource TileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border x:Name="DrillBottomPad" Height="0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Search results (windowed like the main grid) -->
        <ScrollViewer x:Name="SearchView" Visibility="Collapsed"
                      ScrollChanged="Search_ScrollChanged" SizeChanged="Search_SizeChanged">
            <StackPanel>
                <Border x:Name="SearchTopPad" Height="0"/>
                <ItemsControl x:Name="SearchItems" ItemTemplate="{StaticResource TileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border x:Name="SearchBottomPad" Height="0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
