<Window x:Class="CatalogWin.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Books" Width="520" MinWidth="440" SizeToContent="Height">
    <Window.Resources>
        <!-- Simple rectangular button with rounded corners (no default chrome). -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D8D8D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AppMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" x:Name="Form">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="General" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="QueryBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="Title" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="TitleBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="Author" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                <TextBox x:Name="AuthorBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="Series" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
                <ComboBox x:Name="SeriesBox" Grid.Row="3" Grid.Column="1" Margin="0,4"
                          IsEditable="True" StaysOpenOnEdit="True"/>
                <TextBlock Text="Tag" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0"/>
                <ComboBox x:Name="TagBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                          IsEditable="True" StaysOpenOnEdit="True"/>
                <CheckBox x:Name="ExpandCheck" Content="Expand tag to series" IsChecked="True"
                          Grid.Row="5" Grid.Column="1" Margin="0,4"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button Content="Search" Style="{StaticResource RoundedButton}"
                        FontWeight="Bold" Click="Search_Click" IsDefault="True"/>
                <Button Content="Cancel" Style="{StaticResource RoundedButton}"
                        Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
            <ProgressBar x:Name="SearchSpin" IsIndeterminate="True" Height="10" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
