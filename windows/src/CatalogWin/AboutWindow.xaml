<Window x:Class="CatalogWin.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Jocala Catalog" Width="380" Height="300"
        MinWidth="380" MinHeight="300" MaxWidth="380" MaxHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20" HorizontalAlignment="Center">
        <TextBlock Text="Jocala Catalog" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource AppMuted}"
                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="14">
            <Hyperlink NavigateUri="https://www.jocala.com" RequestNavigate="Link_Navigate">
                jocala.com
            </Hyperlink>
        </TextBlock>
        <TextBlock Text="Donations defray server costs and fund development."
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" FontSize="13"/>
        <Button Click="Donate_Click" ToolTip="Donate via PayPal"
                Background="Transparent" BorderThickness="0" Cursor="Hand"
                HorizontalAlignment="Center" Margin="0,12,0,0">
            <Image Source="Assets/donatel.png" Width="190" Height="20" Stretch="Uniform"/>
        </Button>
        <Button Content="Close" Width="80" Margin="0,16,0,0"
                HorizontalAlignment="Center" Click="Close_Click" IsCancel="True" IsDefault="True"/>
    </StackPanel>
</Window>
