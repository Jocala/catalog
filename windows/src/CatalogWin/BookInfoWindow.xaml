<Window x:Class="CatalogWin.BookInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Details" Width="620" Height="600" MinWidth="500" MinHeight="450">
    <!-- Grid, not DockPanel: a Top-docked ScrollViewer measures its whole
         content (long descriptions) and squeezes a Bottom bar to zero. The
         Auto row guarantees the buttons are always visible; the * row scrolls. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,20,8">
                <StackPanel Orientation="Horizontal">
                    <Border Width="160" Height="240" CornerRadius="8" Background="{DynamicResource AppTileBack}">
                        <Image x:Name="CoverImg" Width="160" Height="240" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Top" MaxWidth="380">
                        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AuthorText" FontSize="16" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SeriesText" FontSize="14" Foreground="{DynamicResource AppMuted}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TagsText" FontSize="13" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PubText" FontSize="13" Foreground="{DynamicResource AppMuted}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="IsbnText" FontSize="13" Foreground="{DynamicResource AppMuted}" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="DetailSpin" IsIndeterminate="True" Width="120" Height="10" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
                <Border Margin="0,16,0,0" Padding="10" CornerRadius="6" Background="#0A000000"
                        x:Name="CommentsBox" Visibility="Collapsed">
                    <TextBlock x:Name="CommentsText" TextWrapping="Wrap" FontSize="14"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="20,12" Background="{DynamicResource AppPanelBackground}">
            <StackPanel Orientation="Horizontal">
                <Button Content="📖 Read on Kobo" Padding="16,6" FontWeight="Bold"
                        Click="Read_Click" IsDefault="True"
                        ToolTip="Opens this book on the Kobo via KOReader (internal SSH)"/>
                <Button Content="Close" Padding="16,6" Margin="12,0,0,0" Click="Close_Click" IsCancel="True"/>
                <TextBlock x:Name="KoboStatus" VerticalAlignment="Center" Margin="16,0,0,0"
                           MaxWidth="240" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
