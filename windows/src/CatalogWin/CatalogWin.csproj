<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>JocalaCatalog</AssemblyName>
    <RootNamespace>CatalogWin</RootNamespace>
    <!-- Exe + window icon (multi-size .ico generated from catalog AppIcon.icns). -->
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <!-- Single output tree: the native catalog_ffi.dll is x64-only, so the
         MSBuild AnyCPU default is remapped to x64 (bin\x64\Release) for
         every invocation — sln build, direct build, dotnet test. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Version>1.0</Version>
    <!-- Single-file self-contained release (production): one
         JocalaCatalog.exe in publish/ instead of the ~100-file tree.
         Publish-time only — `dotnet build`/`test` are unaffected.
         Never trim (PublishTrimmed stays false): WPF + WebView2 do not
         survive trimming. RID comes from the publish command line
         (-r win-x64), not from here, so the build output tree
         (bin\x64\Release\net10.0-windows) is unchanged.
         Bundle compression stays OFF on purpose (measured 2026-09-22):
         Deflate inside the bundle shrinks the installed exe but makes it
         incompressible — Inno lzma2/max turned 76.6 MB into 71.1 MB.
         Uncompressed bundle lets lzma2 work on raw IL, which is what
         minimizes the download. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- GPU-less VMs (QXL, no passthrough): WPF falls back to software.
         Forced SoftwareOnly in App.xaml.cs; do not add D3D/QML dependencies. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    <Resource Include="Assets\donatel.png" />
    <!-- Help page: enclosed as a WPF Resource (pack URI) so the single-file
         bundle has no loose files — Content would stay on disk next to the
         exe. Loaded via NavigateToString in HelpWindow. -->
    <Resource Include="Assets\help.html" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native core (Rust catalog-ffi). Recipe-owned file, gitignored: the
         win10 recipe copies catalog_ffi.dll here BEFORE build so it flows
         through build output into the single-file bundle (embedded, not
         loose). Absent on a fresh checkout — the probe fails closed with
         DllNotFoundException, same as a skipped DLL step. -->
    <Content Include="catalog_ffi.dll" Condition="Exists('catalog_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <!-- NU1903: SSH.NET vuln advisories are unactionable here — client talks
       only to our own Kobo e-readers on the LAN. Revisit if upstream ships
       a clean version. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1903;WPF0001</NoWarn>
  </PropertyGroup>

</Project>
