<Application x:Class="CatalogWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Official Fluent styling (.NET 9+); light/dark selected via
                     Application.ThemeMode in UI/Theme. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
                <!-- App chrome brushes (toolbar/panel bands, muted text, tile
                     placeholder) — swapped light/dark by UI/Theme. -->
                <ResourceDictionary Source="UI/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
