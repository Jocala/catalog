<Window x:Class="CatalogWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CatalogWin.UI"
        Title="Settings" Width="620" Height="640" MinWidth="560" MinHeight="500">
    <Window.Resources>
        <!-- Fluent's GroupBox frame ignores BorderBrush, so kill the frame
             via thickness too. Headers alone carry the grouping. -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <!-- Grid, not DockPanel: a Top-docked ScrollViewer measures its whole
         content and squeezes a Bottom bar to zero (same trap as BookInfo).
         The Auto row guarantees Save/Cancel are always visible. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Library Source" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="SMB" GroupName="Src" x:Name="SrcSmb" Checked="Source_Changed"/>
                            <RadioButton Content="Local" GroupName="Src" x:Name="SrcLocal" Margin="12,0,0,0" Checked="Source_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Local Calibre Path" Width="130" VerticalAlignment="Center"/>
                            <TextBox x:Name="LocalDirBox" Width="240" IsEnabled="False" ui:Watermark.Text="Choose a Calibre folder…"/>
                            <Button Content="Browse" Margin="6,0,0,0" Click="BrowseLocal_Click" x:Name="BrowseBtn" IsEnabled="False"/>
                            <Button Content="Test" Margin="6,0,0,0" Click="TestLocal_Click" x:Name="TestLocalBtn" IsEnabled="False"/>
                            <TextBlock x:Name="LocalPass" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="SMB" Margin="0,0,0,8" x:Name="SmbGroup">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SMB Server" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                        <TextBox x:Name="ServerBox" Grid.Row="0" Grid.Column="1" Margin="0,3" FontFamily="Consolas" ui:Watermark.Text="hostname or IP"/>
                        <Button Content="Test SMB" Grid.Row="0" Grid.Column="2" Margin="6,3,0,3" Padding="8,0" Click="TestSmb_Click"/>
                        <TextBlock x:Name="SmbPass" Grid.Row="0" Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="Share" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                        <TextBox x:Name="ShareBox" Grid.Row="1" Grid.Column="1" Margin="0,3" ui:Watermark.Text="share name"/>
                        <TextBlock Text="SMB Calibre Path" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" ToolTip="Folder or database file inside the share, e.g. calibre or calibre/metadata.db"/>
                        <TextBox x:Name="CalibreBox" Grid.Row="2" Grid.Column="1" Margin="0,3" ui:Watermark.Text="folder of metadata.db, e.g. calibre/" ToolTip="e.g. calibre/metadata.db (a bare folder like calibre works too)"/>
                        <Button Content="Test Calibre" Grid.Row="2" Grid.Column="2" Margin="6,3,0,3" Padding="8,0" Click="TestDb_Click"/>
                        <TextBlock x:Name="DbPass" Grid.Row="2" Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="User" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
                        <TextBox x:Name="UserBox" Grid.Row="3" Grid.Column="1" Margin="0,3" ui:Watermark.Text="username"/>
                        <TextBlock Text="Password" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0"/>
                        <PasswordBox x:Name="PassBox" Grid.Row="4" Grid.Column="1" Margin="0,3" ui:Watermark.Text="Required"/>
                        <TextBox x:Name="PassShowBox" Grid.Row="4" Grid.Column="1" Margin="0,3" Visibility="Collapsed" ui:Watermark.Text="Required"/>
                        <Button Content="Show" Grid.Row="4" Grid.Column="2" Margin="6,3,0,3" Padding="8,0" Click="ShowPass_Click" x:Name="ShowPassBtn"/>
                        <TextBlock Text="Domain" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0"/>
                        <TextBox x:Name="DomainBox" Grid.Row="5" Grid.Column="1" Margin="0,3" ui:Watermark.Text="optional"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Kobo" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <!-- Per-row cards (macOS KoboDevice parity): star = default,
                             editable IP, password + Show, per-row ping Test, trash.
                             Built in code-behind (RefreshKoboList). -->
                        <StackPanel x:Name="KoboRows"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="NewKoboBox" Width="150" FontFamily="Consolas" ui:Watermark.Text="Kobo IP address"/>
                            <Button Content="Add" Margin="6,0,0,0" Padding="12,0" Click="KoboAdd_Click"/>
                        </StackPanel>
                        <TextBlock Text="Star selects default for Read on Kobo. IP + password edit in place; password is optional. Ping tests awake."
                                   Foreground="{DynamicResource AppMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="KoboStatus" Foreground="{DynamicResource AppMuted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="General" Margin="0,0,0,8">
                    <StackPanel Margin="8" Orientation="Horizontal">
                        <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeBox" Width="120" Margin="8,0,0,0">
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                        <Button Content="Open Data Folder" Margin="16,0,0,0" Padding="12,0" Click="OpenData_Click"/>
                    </StackPanel>
                </GroupBox>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="4"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Padding="24,4" FontWeight="Bold" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Padding="24,4" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
