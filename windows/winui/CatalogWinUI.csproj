<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Phase 0 matrix probe: template-default TFM on SDK 10. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CatalogWinUI</RootNamespace>
    <AssemblyName>CatalogWinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Native engine (catalog_ffi) is x64-only: single output tree. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged download (no MSIX, no certs): plain exe + Inno.
         EnableMsixTooling STAYS TRUE even unpackaged: false crashes
         self-contained launch at startup (0xc000027b in
         Microsoft.UI.Xaml.dll) — it carries essential resource
         loading logic. Proven against the published failure. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- WASDK app-local: no machine-wide runtime install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <!-- Virtualizing tile grid (gallery primitive): UniformGridLayout
         lives in the Primitives split package in Toolkit v8. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
  </ItemGroup>

  <!-- Never trim: XAML reflection + the native engine do not survive it.
       Single-file stays off (extract-to-temp fights the native DLL path). -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

</Project>
