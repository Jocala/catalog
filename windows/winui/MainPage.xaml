<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CatalogWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CatalogWinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- Phase 0 spike: virtualized tile grid under load + theme swap.
         Stands in for the library gallery (covers arrive Phase 1). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12">
            <TextBlock Text="Catalog spike" FontSize="20" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" />
            <ToggleButton x:Name="ThemeToggle" Content="Dark" Click="ThemeToggle_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsRepeater x:Name="Tiles">
                <ItemsRepeater.Layout>
                    <!-- Toolkit v8 virtualizing wrap (UniformGridLayout is
                         gone in v8; WrapLayout is its successor). -->
                    <controls:WrapLayout HorizontalSpacing="8" VerticalSpacing="8"
                                          Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Width="160" Height="220" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" Padding="8">
                            <StackPanel Spacing="8">
                                <Border Height="140" CornerRadius="4" Background="SteelBlue" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxLines="2" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
